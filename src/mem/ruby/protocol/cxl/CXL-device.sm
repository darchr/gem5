machine(MachineType:CXLDevice, "CXL Device")
    : 
      Cycles memory_latency := 1;
    
    MessageBuffer * reqInFromHost, network="From", virtual_network="0", 
        vnet_type = "request";

    MessageBuffer * respOutToHost, network="From", virtual_network="2",
        vnet_type = "response";

    MessageBuffer *requestToMemory;

    MessageBuffer *responseFromMemory;
    

    state_declaration(State, desc="CXL Device states", default="CXLDevice_State_I") {
        Invalid,  AccessPermission:Invalid, desc="Not Present/Invalid";
        Pending_Read_Data, AccessPermission:Busy, desc="Issued request for Read";
        Pending_Write_Ack, AccessPermission:Busy, desc="Issued request for Write";
    }

    enumeration(Event, desc="CXL Device events") {
        ReadMem, desc="Send memory read request to memory";
        WrMem, desc="Send memory write request to memory";
        MemData, desc="Receive data from memory";
        MemAck, desc="Receive ack from memory";
    }

    Tick clockEdge();

    void getState(Addr addr) {
        return State:Invalid;
    }

    void setState(Addr addr, State state) {
        // Set the state of the address
    }

    AccessPermission getAccessPermission(Addr addr) {
        return AccessPermission:Invalid;
    }

    void setAccessPermission(Addr addr, AccessPermission access) {
        // Set the access permission of the address
    }

    out_port(response_out, CXLMemResponseMsg, respOutToHost);
    out_port(memQueue_out, MemoryMsg, requestToMemory);

    in_port(memQueue_in, MemoryMsg, responseFromMemory) {
        if (memQueue_in.isReady(clockEdge())) {
            peek(memQueue_in, MemoryMsg) {
                if (in_msg.Type == MemoryRequestType:MEMORY_READ) {
                    trigger(Event:MemData, in_msg.addr);
                } else if (in_msg.Type == MemoryRequestType:MEMORY_WB) {
                    trigger(Event:MemAck, in_msg.addr);
                } else {
                    error("Unknown Memory Request Type for address: %#x.", in_msg.addr);
                }
            }
        }
    }

    in_port(request_in, CXLMemRequestMsg, reqInFromHost) {
        if (request_in.isReady(clockEdge())) {
            peek(request_in, CXLMemRequestMsg) {
                if (in_msg.Type == CXL_M2S_Req_Type:MEMORY_READ) {
                    trigger(Event:ReadMem, in_msg.addr);
                } else if (in_msg.Type == CXL_M2S_Req_Type:MEMORY_WRITE) {
                    trigger(Event:WrMem, in_msg.addr);
                } else {
                    error("Unknown CXL Request Type for address: %#x.", in_msg.addr);
                }
            }
        }
    }

    action(sendMemRead, "sMR", desc="Send memory read request") {
        peek(request_in, CXLMemRequestMsg) {
            enqueue(memQueue_out, MemoryMsg, memory_latency) {
                out_msg.addr := in_msg.addr;
                out_msg.Type := MemoryRequestType:MEMORY_READ;
                out_msg.Sender := in_msg.Requestor;
                out_msg.MessageSize := MessageSizeType:Request_Control;
                out_msg.Len := 0;
            }
        }
    }

    action(sendMemWrite, "sMW", desc="Send memory write request") {
        peek(request_in, CXLMemRequestMsg) {
            enqueue(memQueue_out, MemoryMsg, memory_latency) {
                out_msg.addr := in_msg.addr;
                out_msg.Type := MemoryRequestType:MEMORY_WB;
                out_msg.Sender := in_msg.Requestor;
                out_msg.MessageSize := MessageSizeType:Writeback_Data;
                out_msg.DataBlk := in_msg.DataBlk;
                out_msg.Len := 0;
            }
        }
    }

    action(sendDataToHost, "sDH", desc="Send memory data to host") {
        peek(memQueue_in, MemoryMsg) {
            enqueue(respOutToHost, CXLMemResponseMsg, memory_latency) {
                out_msg.addr := in_msg.addr;
                out_msg.Type := CXL_S2M_Resp_Type:MemData;
                out_msg.Responder := machineID;
                out_msg.Destination.add(in_msg.OriginalRequestorMachId);
                out_msg.DataBlk := in_msg.DataBlk;
                out_msg.MessageSize := MessageSizeType:Data;
            }
        }
    }

    action(sendAckToHost, "sAH", desc="Send memory ack to host") {
        peek(memQueue_in, MemoryMsg) {
            enqueue(respOutToHost, CXLMemResponseMsg, memory_latency) {
                out_msg.addr := in_msg.addr;
                out_msg.Type := CXL_S2M_Resp_Type:Cmp;
                out_msg.Responder := machineID;
                out_msg.Destination.add(in_msg.OriginalRequestorMachId);
                out_msg.MessageSize := MessageSizeType:Ack;
            }
        }
    }

    action(popRequestQueue, "pQ", desc="Pop the request queue") {
        request_in.dequeue(clockEdge());
    }

    action(popMemQueue, "pM", desc="Pop the memory queue") {
        dequeueMemRespQueue();
    }

    transition(Invalid, ReadMem, Pending_Read_Data) {
        sendMemRead;
        popRequestQueue;
    }

    transition(Invalid, WrMem, Pending_Write_Ack) {
        sendMemWrite;
        popRequestQueue;
    }

    transition(Pending_Read_Data, MemData, Invalid) {
        sendDataToHost;
        popMemQueue;
    }

    transition(Pending_Write_Ack, MemAck, Invalid) {
        sendAckToHost;
        popMemQueue;
    }
